// UI test bundle. Drives the app as a separate process, so no test host.

PRODUCT_NAME = SunnieDaysUITests
PRODUCT_BUNDLE_IDENTIFIER = $(SUNNIE_BUNDLE_ID_PREFIX).app.uitests
PRODUCT_MODULE_NAME = SunnieDaysUITests

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1

GENERATE_INFOPLIST_FILE = YES
TEST_TARGET_NAME = SunnieDays

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
