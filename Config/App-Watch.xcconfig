// Apple Watch app target.

PRODUCT_NAME = SunnieDaysWatch
PRODUCT_BUNDLE_IDENTIFIER = $(SUNNIE_BUNDLE_ID_PREFIX).app.watchkitapp
PRODUCT_MODULE_NAME = SunnieDaysWatch

SDKROOT = watchos
TARGETED_DEVICE_FAMILY = 4
SUPPORTED_PLATFORMS = watchos watchsimulator

INFOPLIST_FILE = Apps/Watch/Resources/Info.plist
GENERATE_INFOPLIST_FILE = NO

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

ENABLE_PREVIEWS = YES
SKIP_INSTALL = YES

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// Entitlements are off by default for the same reason as the iPhone target;
// see Config/App-iOS.xcconfig.
