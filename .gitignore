# Signing material must never enter the repository.
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# Creator source material lives outside the runtime bundle (ADR-006).
# Track the manifests and READMEs, not the large binaries.
AssetsSource/**/*.psd
AssetsSource/**/*.ai
AssetsSource/**/*.sketch
AssetsSource/**/*.tiff
CreatorAudioSource/**/*.mid
CreatorAudioSource/**/*.midi
CreatorAudioSource/**/*.logicx
CreatorAudioSource/**/*.wav
CreatorAudioSource/**/*.aiff
