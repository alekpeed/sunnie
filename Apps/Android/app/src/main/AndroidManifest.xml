<?xml version="1.0" encoding="utf-8"?>
<!--
  No permissions are declared, and that is worth noticing rather than assuming.

  This build plays a game locally and talks to nothing. When the multiplayer
  transport lands it will need INTERNET and nothing else — never contacts, never
  storage, never location. The privacy boundary in ADR-035 says journal,
  wellness, health, plants, meals, trips, photos, audio, and preferences never
  reach the network, and a permission list that stays this short is the cheapest
  way for anyone to check that claim.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
