<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		ENTITLEMENT PLACEHOLDER — NOT ACTIVE (ADR-012).

		The App Group is how this extension reads the snapshot the app writes.
		It must match `WidgetSnapshotStore.appGroupIdentifier` and the group in
		the app's own entitlements exactly; a mismatch is invisible and looks
		precisely like "the widget never updates".

		With no group configured, the store resolves no container and every
		widget shows its "open Sunnie Days" state.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sunniedays.app</string>
	</array>
</dict>
</plist>
