"game.wordLayover.name" = "Word Layover";
"game.wordLayover.summary" = "Hop between places by following what one word means in another language.";
"game.wordLayover.rules" = "Each stop gives you a clue. Answer it, and the answer itself becomes the bridge to the next clue — sometimes a meaning, sometimes a translation, sometimes just how it sounds. Nudges are there whenever you want one; they cost points and nothing else.";

"game.postcardCipher.name" = "Postcard Cipher";
"game.postcardCipher.summary" = "Work out where a postcard came from, one clue at a time.";
"game.postcardCipher.rules" = "Open as many clues as you like, in whatever order you like. Each one costs a few points, so the puzzle is choosing which clues you actually need. A wrong guess opens the cheapest clue you haven't seen and lets you keep going.";

"game.jungleLogic.name" = "Jungle Logic";
"game.jungleLogic.summary" = "Sort out which plant lives where, from a handful of clues.";
"game.jungleLogic.rules" = "Every clue is true, and exactly one arrangement fits all of them. Tap a row to fill it in; nothing is dragged. When the whole board is filled, check it and see how it went.";

"game.memoryAtlas.name" = "Memory Atlas";
"game.memoryAtlas.summary" = "Study a scrapbook page, then answer questions about what was on it.";
"game.memoryAtlas.rules" = "Look at the page for as long as you want — the timer can be taken away entirely, and doing that costs nothing. Then the page goes and the questions come.";

"game.lostInTranslation.name" = "Lost in Translation";
"game.lostInTranslation.summary" = "Follow a phrase through several languages, cognates and false friends alike.";
"game.lostInTranslation.rules" = "Each step asks for one word. Some steps use a word that really is related to the last one; some use a word that only looks related. After each answer you'll see which it was.";

