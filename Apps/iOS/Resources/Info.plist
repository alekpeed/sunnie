<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Sunnie Days</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Deep links resolve through DeepLinkParser into typed AppRoutes. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sunniedays</string>
			</array>
		</dict>
	</array>

	<!--
		Background audio, for the generated noise player only. Without this iOS
		suspends the app when the user leaves it and playback stops — which looks
		exactly like an audio bug and is not one (NOISE_IMPLEMENTATION.md §9).

		A sleep sound that dies when the screen locks is not a sleep sound, so this
		is load-bearing rather than a nicety. Sunnie's cues and ambience do not use
		it: they run under .ambient and stop with the app, which is correct for them
		(ADR-018).
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!--
		Export compliance, answered here rather than by hand.

		Without this key every upload arrives in App Store Connect as "Missing
		Compliance" and sits there, undistributable, until somebody opens the
		build and answers the same question in a web form. Declared in the
		bundle, the answer travels with the build and TestFlight processing runs
		straight through.

		`false` is the accurate answer, not the convenient one. The app performs
		no encryption of its own. What it does touch is exempt under the
		relevant note: HTTPS to Apple's own services (WeatherKit, CloudKit) and
		iOS file data protection, both of which are the platform's encryption
		rather than the app's. If custom cryptography is ever added — an
		encrypted export archive, a passphrase on the journal — this key must be
		revisited, because it would no longer be true.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!--
		Usage descriptions.

		These are written in Sunnie's voice but never use the nickname — a
		permission prompt is an ineligible context (TONE_COPY_AND_BEHAVIOR.md).
		Each says what the app does with the data and implies that declining is
		fine, because it genuinely is: none of these is required to use the app.

		Only the permissions the current build can actually request are listed.
		HealthKit, calendar, and location descriptions are added in the phase
		that introduces them, so the App Store never sees a declared purpose the
		app does not use.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Sunnie can add photos of your plants to their growth history. Photos stay on your devices.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Sunnie can add a trip to your calendar and notice if it moves. Your trips work fine without it.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Sunnie can read steps, sleep, and other figures you choose, one at a time, to show them alongside your day. Nothing is read until you turn it on, and everything works without it.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Sunnie can save your mindful minutes and the water you log to Health, so they appear alongside the rest of your day. Only what you record here is written.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sunnie can record a short voice note for your journal. Recordings stay on your devices.</string>
</dict>
</plist>
