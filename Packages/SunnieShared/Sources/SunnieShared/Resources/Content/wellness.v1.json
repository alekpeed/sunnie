    "minimumAppVersion": "0.1.0"
  },
  "affirmations": [
    {
      "id": "sunnie.affirmation.gentle.01",
      "text": "One little thing at a time is enough.",
      "localizationKey": "sunnie.affirmation.gentle.01",
      "tags": ["gentle", "selfCompassion"],
      "phases": [],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.gentle.02",
      "text": "You're allowed to take this slowly.",
      "localizationKey": "sunnie.affirmation.gentle.02",
      "tags": ["gentle", "selfCompassion"],
      "phases": [],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.gentle.03",
      "text": "Whatever today looks like, it's alright.",
      "localizationKey": "sunnie.affirmation.gentle.03",
      "tags": ["gentle", "selfCompassion"],
      "phases": [],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.gentle.04",
      "text": "Resting counts too.",
      "localizationKey": "sunnie.affirmation.gentle.04",
      "tags": ["gentle", "rest"],
      "phases": [],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.morning.01",
      "text": "A quiet start is still a start.",
      "localizationKey": "sunnie.affirmation.morning.01",
      "tags": ["morning", "gentle"],
      "phases": ["morning"],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.morning.02",
      "text": "There's no right way for a morning to go.",
      "localizationKey": "sunnie.affirmation.morning.02",
      "tags": ["morning", "selfCompassion"],
      "phases": ["morning"],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.encouragement.01",
      "text": "You've handled harder days than this one.",
      "localizationKey": "sunnie.affirmation.encouragement.01",
      "tags": ["encouragement"],
      "phases": [],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.encouragement.02",
      "text": "Look at everything you've already kept going.",
      "localizationKey": "sunnie.affirmation.encouragement.02",
      "tags": ["encouragement"],
      "phases": ["day", "afternoon"],
      "suitsSensitiveMoments": false
    },
    {
      "id": "sunnie.affirmation.evening.01",
      "text": "The day can be finished now, whatever's left in it.",
      "localizationKey": "sunnie.affirmation.evening.01",
      "tags": ["evening", "rest"],
      "phases": ["evening", "night"],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.evening.02",
      "text": "Tomorrow gets to be its own thing.",
      "localizationKey": "sunnie.affirmation.evening.02",
      "tags": ["evening", "rest"],
      "phases": ["evening", "night", "lateNight"],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.travel.01",
      "text": "Travelling well mostly means being kind to yourself in transit.",
      "localizationKey": "sunnie.affirmation.travel.01",
      "tags": ["travel", "selfCompassion"],
      "phases": [],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.home.01",
      "text": "It's good to be back.",
      "localizationKey": "sunnie.affirmation.home.01",
      "tags": ["home"],
      "phases": [],
      "suitsSensitiveMoments": true
    },
    {
      "id": "sunnie.affirmation.plants.01",
      "text": "Green things grow slowly, and that's the whole point of them.",
      "localizationKey": "sunnie.affirmation.plants.01",
      "tags": ["plants", "gentle"],
      "phases": [],
      "suitsSensitiveMoments": true
    }
  ],
